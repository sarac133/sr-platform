# Netlify environment variables (Site settings, Environment variables). Never commit real values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Supabase, Project settings, API, service_role (secret)
GOOGLE_CLIENT_ID=                     # Google Cloud, OAuth client (Web application)
GOOGLE_CLIENT_SECRET=
SITE_URL=https://your-site.netlify.app   # no trailing slash
